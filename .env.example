# CLIPVAULT AI - Environment Configuration

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Python AI Processing Engine
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8000

# Local Ollama LLM Service
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional: Official Google YouTube Data API v3 Key
# If configured, retrieves extended metadata (exact duration, livestream status, description, and high-res thumbnails).
# If omitted, CLIPVAULT AI automatically utilizes YouTube's official public oEmbed metadata service with zero credentials required.
YOUTUBE_API_KEY=

# FFmpeg Paths (Optional - automatically resolved from Winget / PATH if omitted)
# FFMPEG_PATH=
# FFPROBE_PATH=

